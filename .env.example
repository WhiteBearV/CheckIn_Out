# =============================================================================
# FaceReg — Environment Variables Template
# =============================================================================
# วิธีใช้:
#   1. cp .env.example .env
#   2. แก้ค่าให้ตรงกับ environment ของคุณ
#   3. ค่าที่มี (REQUIRED) ต้องตั้งทุกค่า; ค่า (OPTIONAL) ใช้ default ได้
#
# CRITICAL: ห้าม commit ไฟล์ .env เข้า git (อยู่ใน .gitignore แล้ว)
# =============================================================================


# ─── ตัวเชื่อม External API (ดึงข้อมูลพนักงาน) ────────────────────────────────
# (REQUIRED ถ้าใช้กับระบบ HR ภายนอก — ถ้าไม่มี ตั้งเป็น URL fake ก็ได้แต่ระบบจะ fall ไป offline cache)
EXTERNAL_API_URL=https://your-hr-api.example.com
EXTERNAL_API_KEY=YOUR_API_KEY_HERE


# ─── Stream Server (port 8001) ────────────────────────────────────────────────
# (OPTIONAL — default 8001)
STREAM_PORT=8001

# (REQUIRED) URL ที่ stream_server ใช้เรียก api.py (ปกติ localhost)
LOCAL_API_URL=http://localhost:8000


# ─── Internal Push Token ──────────────────────────────────────────────────────
# (REQUIRED ใน headless/production mode)
# main.py ส่ง frame/state ให้ stream_server ผ่าน HTTP POST ต้องแนบ header นี้
# ถ้าไม่ตั้ง → main.py โดน 401 ทุก request → ระบบหน้าเว็บไม่เห็น frame เลย
# สุ่มเอง: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_PUSH_TOKEN=YOUR_RANDOM_64_HEX_HERE


# ─── JWT Authentication ───────────────────────────────────────────────────────
# (REQUIRED) JWT secret สำหรับเข็นเข้าระบบ login
# สุ่มเอง: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=YOUR_RANDOM_64_HEX_CHARS_HERE

# (OPTIONAL — default 8) อายุ token เป็นชั่วโมง
# Production แนะนำ 8-24; dev ใช้ 720 (30 วัน) ก็ได้
JWT_TTL_HOURS=8


# ─── Admin API Key (Legacy fallback) ──────────────────────────────────────────
# (OPTIONAL) สำหรับ script เก่าที่ยังใช้ X-Admin-Key แทน JWT
# ถ้าไม่ใช้ ปล่อยว่างได้
ADMIN_API_KEY=


# ─── CORS Origins ─────────────────────────────────────────────────────────────
# (REQUIRED ใน production) — domain/IP ที่ frontend ใช้เรียก stream_server
# คั่นด้วย comma; รวม protocol + port (ถ้ามี)
# ตัวอย่าง:
#   - dev:   http://localhost:5173,http://localhost:4173
#   - prod:  https://attendance.company.com,http://192.168.1.100
CORS_ORIGINS=http://localhost:5173,http://localhost:4173


# ─── Telegram Notification (Optional) ─────────────────────────────────────────
# (OPTIONAL) แจ้งเตือนเมื่อระบบ start/stop/error ผ่าน Telegram bot
# ถ้าไม่ใช้ → ปล่อยว่าง (ระบบจะ skip notify ไม่ error)
# วิธีหา token: คุยกับ @BotFather; chat_id: ส่งข้อความให้ bot แล้วเรียก getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ─── Offline Queue (Phase 2 — ทนเน็ตดับ) ─────────────────────────────────────
# (OPTIONAL — default ทั้งหมด)
OFFLINE_QUEUE_PATH=./offline_queue.db
SYNC_WORKER_INTERVAL=30          # วินาที: drain queue ทุก N วิ
EMPLOYEE_CACHE_REFRESH=3600      # วินาที: refresh cache ทุก N วิ (default 1 ชม.)
SYNC_BATCH_SIZE=50               # rows: drain ทีละ N rows


# ─── Image Cleanup / Retention ────────────────────────────────────────────────
# (OPTIONAL — default 365 / 7)
PICSAVE_RETENTION_DAYS=365       # เก็บรูป PicSAVE/ กี่วัน
SNAP_RETENTION_DAYS=7            # เก็บรูป live_snap_*.jpg กี่วัน


# ─── Face Recognition (Optional override) ─────────────────────────────────────
# (OPTIONAL) override path รูปต้นแบบ (default = ./known_faces/)
KNOWN_FACES_DIR=./known_faces


# ─── Camera (Legacy single-cam mode) ──────────────────────────────────────────
# (OPTIONAL) ใช้ตอนรัน main.py แบบ standalone หา cameras.json ไม่เจอ
CAMERA_URL=rtsp://admin:password@192.168.x.x:554/path


# ─── Headless Mode Flag ───────────────────────────────────────────────────────
# (อย่าตั้งเอง) stream_server จะ set env นี้ตอน spawn main.py แบบ headless
# FACE_HEADLESS=1
# FACE_CAMERA_CHILD=1
# FACE_CAM_IDS=cam1,cam2

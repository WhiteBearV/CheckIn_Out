[Unit]
Description=FaceReg — สำรองฐานข้อมูล PostgreSQL
After=network.target postgresql.service

[Service]
Type=oneshot
User=maeb
WorkingDirectory=/home/maeb/internship_work/FaceReg
ExecStart=/home/maeb/internship_work/FaceReg/venv/bin/python /home/maeb/internship_work/FaceReg/backup_db.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=facereg-backup
